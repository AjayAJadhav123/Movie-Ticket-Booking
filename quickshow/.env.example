# QuickShow Environment Configuration Template
# Do NOT place real secrets in this file. Copy to .env and fill out your credentials.

# ----------------------------------------------------
# SERVER CONFIGURATION (.env)
# ----------------------------------------------------
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-production-frontend.vercel.app
BACKEND_URL=https://your-production-backend.onrender.com

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/quickshow?retryWrites=true&w=majority

# Clerk Authentication (Get from Clerk Dashboard)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# TMDB API (Get from themoviedb.org)
TMDB_API_KEY=your_tmdb_api_key_here

# Cashfree Payments (Get from cashfree.com/merchant)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=PRODUCTION  # or SANDBOX for testing

# OpenAI (For AI Booking Assistant)
OPENAI_API_KEY=sk-...

# Email Configuration (Optional - Resend/Nodemailer)
# SENDER_EMAIL=your_email@domain.com
# SMTP_PASS=your_smtp_password
# RESEND_API_KEY=re_...

# ----------------------------------------------------
# CLIENT CONFIGURATION (client/.env)
# ----------------------------------------------------
VITE_BACKEND_URL=https://your-production-backend.onrender.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Note: VITE_TMDB_API_KEY should ideally be removed if proxying all TMDB requests through backend
VITE_TMDB_API_KEY=your_tmdb_api_key_here
